name: Release to Google Play

# Manual/tag-triggered pipeline that builds a signed AAB and uploads it
# to Google Play via the Play Developer API.
#
# One-time setup (repo Settings > Secrets and variables > Actions):
#   Secrets:
#     KEYSTORE_BASE64 / KEYSTORE_PASSWORD / KEY_ALIAS / KEY_PASSWORD
#     GOOGLE_PLAY_SERVICE_ACCOUNT_JSON  - full JSON key of a Play Console
#       service account with the "Release manager" role.
#   Variable:
#     PLAY_PUBLISH_ENABLED = true
#
# With the variable unset the publish job skips cleanly, so this file is
# safe to keep in the repo before the Play setup exists.

on:
  workflow_dispatch:
    inputs:
      track:
        description: "Play track"
        type: choice
        options: [internal, alpha, beta, production]
        default: internal
  push:
    tags: ["v*"]

jobs:
  publish:
    if: vars.PLAY_PUBLISH_ENABLED == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      # Restores/saves the Gradle dependency + build cache between
      # runs, keyed on the project's Gradle files — without it every
      # publish build starts Gradle cold. (Flutter SDK + Pub are
      # already cached via flutter-action's cache: true below.)
      - name: Set up Gradle (cached)
        uses: gradle/actions/setup-gradle@v4

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - run: flutter pub get

      - name: Decode keystore
        env:
          KS: ${{ secrets.KEYSTORE_BASE64 }}
        run: echo "$KS" | base64 -d > "$RUNNER_TEMP/upload-keystore.jks"

      - name: Build signed AAB
        env:
          KEYSTORE_PATH: ${{ runner.temp }}/upload-keystore.jks
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
        run: flutter build appbundle --release

      - name: Upload to Google Play
        uses: r0adkll/upload-google-play@v1
        with:
          serviceAccountJsonPlainText: ${{ secrets.GOOGLE_PLAY_SERVICE_ACCOUNT_JSON }}
          packageName: com.gherdev.personal_cashflow
          releaseFiles: build/app/outputs/bundle/release/app-release.aab
          track: ${{ inputs.track || 'internal' }}
          status: completed
          mappingFile: build/app/outputs/mapping/release/mapping.txt
